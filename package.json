{
  "name": "draganddrop",
  "version": "1.0.0",
  "description": "Drag-and-drop multi-page website builder that exports clean HTML with generated CSS.",
  "scripts": {
    "build": "npm-run-all build:css build:icons build:main",
    "build:css": "tailwindcss -i src/tailwind.css -o dist/utilities.css --minify",
    "build:icons": "esbuild src/icons.js --bundle --minify --outfile=dist/icons.js",
    "build:main": "esbuild src/main.js --bundle --minify --sourcemap --outfile=dist/main.js",
    "start": "npm run build && http-server . -p 8080 -c-1 -o",
    "dev": "npm-run-all --parallel watch js:watch main:watch serve",
    "watch": "tailwindcss -i src/tailwind.css -o dist/utilities.css --watch",
    "js:watch": "esbuild src/icons.js --bundle --minify --outfile=dist/icons.js --watch",
    "main:watch": "esbuild src/main.js --bundle --sourcemap --outfile=dist/main.js --watch",
    "serve": "live-server --no-css-inject"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roycanales17/Web-Builder.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/roycanales17/Web-Builder/issues"
  },
  "homepage": "https://github.com/roycanales17/Web-Builder#readme",
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.0.0",
    "@fortawesome/free-solid-svg-icons": "^7.0.0",
    "@tailwindcss/cli": "^4.1.3"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.8",
    "http-server": "^14.1.1",
    "live-server": "^1.2.2",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.11"
  }
}
